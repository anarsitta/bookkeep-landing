# Email оператора — для документов, футера и приёма заявок (отправка через Яндекс SMTP)
OPERATOR_EMAIL=your-email@yandex.ru
# Пароль приложения Яндекс (Безопасность → Пароли приложений)
YANDEX_APP_PASSWORD=your-yandex-app-password
# Куда проксировать /api при dev (Vite). На сервере — URL вашего бэкенда
API_PROXY_TARGET=http://127.0.0.1:3001
# Ссылки на соцсети в футере
OPERATOR_LINK_VK=https://vk.com/...
OPERATOR_LINK_MAX=https://max.by/...
